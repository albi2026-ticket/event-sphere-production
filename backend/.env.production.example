APP_NAME=Tiketa
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.tiketa.example
FRONTEND_URL=https://tiketa.example
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"
SANCTUM_STATEFUL_DOMAINS=tiketa.example,www.tiketa.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME_DATABASE_HOST
DB_PORT=5432
DB_DATABASE=CHANGE_ME_DATABASE_NAME
DB_USERNAME=CHANGE_ME_DATABASE_USER
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=.tiketa.example
SESSION_STORE=redis

BROADCAST_CONNECTION=log
CACHE_STORE=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
FILESYSTEM_DISK=s3
EVENT_IMAGES_DISK=s3

REDIS_CLIENT=phpredis
REDIS_HOST=CHANGE_ME_REDIS_HOST
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=5

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS=hello@tiketa.example
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=CHANGE_ME_STORAGE_BUCKET
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

TICKET_EMAIL_LINK_EXPIRATION_DAYS=7
CHECKOUT_RESERVATION_MINUTES=5

# Payment provider integration is intentionally planned for a later production sprint.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=USD
STRIPE_CHECKOUT_SUCCESS_URL="${FRONTEND_URL}/checkout-success?session_id={CHECKOUT_SESSION_ID}&order_id={ORDER_ID}"
STRIPE_CHECKOUT_CANCEL_URL="${FRONTEND_URL}/checkout-cancelled?order={ORDER_NUMBER}"

VITE_APP_NAME="${APP_NAME}"
