APP_NAME=Tiketa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tiketa.example
FRONTEND_URL=https://tiketa.example
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"
SANCTUM_STATEFUL_DOMAINS=tiketa.example,www.tiketa.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=your-database-host
DB_PORT=5432
DB_DATABASE=your-database-name
DB_USERNAME=your-database-user
DB_PASSWORD=replace-with-secure-database-password
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=.tiketa.example
SESSION_STORE=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_DRIVER=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM_ADDRESS="hello@tiketa.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TICKET_EMAIL_LINK_EXPIRATION_DAYS=7
CHECKOUT_RESERVATION_MINUTES=5
STRIPE_SECRET=replace-with-stripe-live-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-live-webhook-secret
STRIPE_CURRENCY=USD
STRIPE_CHECKOUT_SUCCESS_URL="${FRONTEND_URL}/checkout-success?session_id={CHECKOUT_SESSION_ID}&order_id={ORDER_ID}"
STRIPE_CHECKOUT_CANCEL_URL="${FRONTEND_URL}/checkout-cancelled?order={ORDER_NUMBER}"

VITE_APP_NAME="${APP_NAME}"
